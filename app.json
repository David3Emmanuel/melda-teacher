{
  "expo": {
    "name": "MELDA",
    "slug": "melda",
    "scheme": "melda",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.melda.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "MELDA",
      "shortName": "MELDA",
      "themeColor": "#4F46E5",
      "backgroundColor": "#F4F5F7",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"]
  }
}
