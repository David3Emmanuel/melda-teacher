# Copy to .env (git-ignored). Points the teacher app at the melda-backend API.
#
# The Anthropic key now lives ONLY in the backend - the app never holds it, so
# there is no secret to inline into the client bundle.
#
# localhost works for web and simulators; a physical device needs the host LAN IP
# (e.g. http://192.168.1.10:4000).
EXPO_PUBLIC_API_URL=http://localhost:4000
