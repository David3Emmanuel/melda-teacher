# Copy to .env (git-ignored) and fill in to run MELDA against the real model.
# With no key, the app uses the deterministic mock AI and runs fully offline.
#
# NOTE: EXPO_PUBLIC_ values are inlined into the client bundle and are visible to
# anyone with the app. This is fine for a local demo only. A real deployment must
# proxy these calls through a server that holds the key.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5.
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-5
