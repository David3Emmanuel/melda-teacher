    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-router": "~56.2.19",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
