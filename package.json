{
  "name": "melda-teacher",
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:client": "tsx src/api/client.check.ts",
    "check:insights": "tsx src/weakestConcept.check.ts",
    "check": "pnpm check:client && pnpm check:insights",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.3.16",
    "expo": "54.0.37",
    "expo-constants": "~18.0.14",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "melda-shared": "github:David3Emmanuel/melda-shared#v0.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.1.17",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}

